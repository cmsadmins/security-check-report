includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 70400
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - security-check-report.php
        - includes
        - config
        - uninstall.php
    excludePaths:
        - vendor
        - node_modules
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # WP-CLI only exists when the command line runner loads the plugin.
        - '#unknown class WP_CLI#'
        - '#format_items not found#'
