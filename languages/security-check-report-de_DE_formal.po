msgstr "jeder kann ein Konto anlegen"

#: includes/checks/class-cascr-checks-accounts.php:659
msgid "existing accounts can create new sites"
msgstr "bestehende Konten können neue Websites anlegen"

#: includes/checks/class-cascr-checks-accounts.php:660
