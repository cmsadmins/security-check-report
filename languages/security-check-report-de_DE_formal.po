#: includes/checks/class-cascr-checks-core.php:433
#, php-format
msgid "%d active plugin has an update waiting."
msgid_plural "%d active plugins have updates waiting."
msgstr[0] "%d aktives Plugin wartet auf ein Update."
msgstr[1] "%d aktive Plugins warten auf ein Update."

#: includes/checks/class-cascr-checks-core.php:443
#: includes/checks/class-cascr-checks-core.php:497
msgid "Install the updates from Dashboard, Updates."
msgstr "Installieren Sie die Updates unter Dashboard, Aktualisierungen."

#: includes/checks/class-cascr-checks-core.php:462
msgid "Theme update information is not available."
msgstr "Für Themes liegen keine Update-Informationen vor."

#. translators: 1: theme name, 2: available version.
#: includes/checks/class-cascr-checks-core.php:474
#, php-format
msgid "%1$s (update to %2$s)"
msgstr "%1$s (Update auf %2$s)"

#: includes/checks/class-cascr-checks-core.php:481
msgid "All themes are up to date."
msgstr "Alle Themes sind auf dem neuesten Stand."

#. translators: %d: number of themes with a pending update.
#: includes/checks/class-cascr-checks-core.php:487
#, php-format
msgid "%d theme has an update waiting."
msgid_plural "%d themes have updates waiting."
msgstr[0] "Für %d Theme wartet ein Update."
msgstr[1] "Für %d Themes warten Updates."

#: includes/checks/class-cascr-checks-core.php:528
msgid "No inactive plugins or unused themes are installed."
msgstr "Es sind keine inaktiven Plugins oder ungenutzten Themes installiert."

#. translators: %s: plugin name.
#: includes/checks/class-cascr-checks-core.php:534
#, php-format
msgid "inactive plugin: %s"
msgstr "inaktives Plugin: %s"

#. translators: %s: theme name.
#: includes/checks/class-cascr-checks-core.php:538
#, php-format
msgid "unused theme: %s"
