msgstr "usata l'ultima volta %1$s fa da %2$s"

#: includes/checks/class-cascr-checks-accounts.php:729
msgid "No application passwords are in use by privileged accounts."
msgstr ""
"Nessuna password per le applicazioni è in uso da parte di account "
"privilegiati."

#. translators: %d: number of application passwords in use.
#: includes/checks/class-cascr-checks-accounts.php:736
#, php-format
