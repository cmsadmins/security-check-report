msgstr[0] "%d administrator nie ma drugiego składnika."
msgstr[1] "%d administratorzy nie mają drugiego składnika."
msgstr[2] "%d administratorów nie ma drugiego składnika."

#: includes/checks/class-cascr-checks-accounts.php:640
