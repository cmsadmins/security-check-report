msgstr ""
"Setze WP_DEBUG in der wp-config.php auf false, mindestens aber "
"WP_DEBUG_DISPLAY."

#: includes/checks/class-cascr-checks-config.php:49
msgid "Debug mode is on."
msgstr "Der Debug-Modus ist an."

#: includes/checks/class-cascr-checks-config.php:52
