msgid ""
"Set the directory to 755 or 750. It only needs to be writable by the account"
" that runs PHP."
msgstr ""
"Pon el directorio en 755 o 750. Solo necesita permiso de escritura la cuenta"
" que ejecuta PHP."

#: includes/checks/class-cascr-checks-files.php:117
msgid "The uploads directory is not writable by everyone."
msgstr "El directorio uploads no tiene permiso de escritura para todos."

#: includes/checks/class-cascr-checks-files.php:155
msgid "Core directories are writable by everyone on the server."
msgstr ""
"Cualquier cuenta del servidor puede escribir en los directorios del núcleo."

#: includes/checks/class-cascr-checks-files.php:158
msgid "Set the directories to 755 or 750."
msgstr "Pon los directorios en 755 o 750."

#: includes/checks/class-cascr-checks-files.php:163
msgid "The permissions of the core directories could not be read."
msgstr "No se han podido leer los permisos de los directorios del núcleo."

#: includes/checks/class-cascr-checks-files.php:166
msgid "No core directory is writable by everyone."
msgstr "Ningún directorio del núcleo tiene permiso de escritura para todos."

#: includes/checks/class-cascr-checks-files.php:222
msgid ""
"Nothing below the web root is writable by everyone, leaving aside the paths "
"that have a check of their own."
msgstr ""
"Nada bajo la raíz web tiene permiso de escritura para todos, sin contar las "
"rutas que tienen su propia comprobación."

#. translators: %d: number of world-writable paths.
#: includes/checks/class-cascr-checks-files.php:228
#, php-format
msgid "%d path is writable by every account on the server."
msgid_plural "%d paths are writable by every account on the server."
msgstr[0] "Cualquier cuenta del servidor puede escribir en %d ruta."
msgstr[1] "Cualquier cuenta del servidor puede escribir en %d rutas."

#: includes/checks/class-cascr-checks-files.php:238
msgid ""
"Set files to 644 and directories to 755. Nothing needs to be world-writable."
" wp-config.php, the core directories and the uploads folder are not listed "
"here, they have a check of their own."
msgstr ""
"Pon los archivos en 644 y los directorios en 755. Nada necesita permiso de "
"escritura para todos. wp-config.php, los directorios del núcleo y el "
"directorio uploads no aparecen aquí porque tienen su propia comprobación."

#: includes/checks/class-cascr-checks-files.php:286
msgid "The uploads directory could not be read."
msgstr "No se ha podido leer el directorio uploads."

#. translators: 1: file path, 2: file size, already formatted, 3: why the file
#. was reported, or an empty string.
#: includes/checks/class-cascr-checks-files.php:335
#, php-format
msgid "%1$s (%2$s)%3$s"
msgstr "%1$s (%2$s)%3$s"

#. translators: %s: reason the file was reported, for example "it reads
#. $_SERVER".
#: includes/checks/class-cascr-checks-files.php:340
#, php-format
msgid ", reported because %s"
msgstr ", señalado porque %s"

#: includes/checks/class-cascr-checks-files.php:352
msgid "The uploads directory could not be scanned completely."
msgstr "No se ha podido analizar por completo el directorio uploads."

#. translators: %d: number of executable files found in uploads.
#: includes/checks/class-cascr-checks-files.php:359
#, php-format
msgid "%d executable file sits in the uploads directory."
msgid_plural "%d executable files sit in the uploads directory."
msgstr[0] "Hay %d archivo ejecutable en el directorio uploads."
msgstr[1] "Hay %d archivos ejecutables en el directorio uploads."

#: includes/checks/class-cascr-checks-files.php:369
msgid ""
"Media uploads never need to be executable. Inspect each file before deleting"
" it."
msgstr ""
"Los archivos de medios nunca necesitan ser ejecutables. Revisa cada archivo "
"antes de borrarlo."

#. translators: %d: number of files in uploads that the web server does not
#. run.
#: includes/checks/class-cascr-checks-files.php:377
#, php-format
msgid ""
"%d file that the web server does not run sits in the uploads directory."
msgid_plural ""
"%d files that the web server does not run sit in the uploads directory."
msgstr[0] ""
"Hay %d archivo que el servidor web no ejecuta en el directorio uploads."
msgstr[1] ""
"Hay %d archivos que el servidor web no ejecuta en el directorio uploads."

#: includes/checks/class-cascr-checks-files.php:387
msgid ""
"Installers and scripts handed out through the media library are downloads, "
"not code this site runs. Check that each one is meant to be there."
msgstr ""
"Los instaladores y scripts que se ofrecen a través de la biblioteca de "
"medios son descargas, no código que ejecute este sitio. Comprueba que cada "
"uno debe estar ahí."

#: includes/checks/class-cascr-checks-files.php:391
msgid "The uploads directory holds no executable files."
msgstr "El directorio uploads no contiene archivos ejecutables."

#: includes/checks/class-cascr-checks-files.php:412
msgid "the tokeniser is unavailable"
msgstr "el tokenizador no está disponible"

#: includes/checks/class-cascr-checks-files.php:418
msgid "its size could not be read"
msgstr "no se ha podido leer su tamaño"

#: includes/checks/class-cascr-checks-files.php:422
msgid "it is too large to be a guard"
msgstr "es demasiado grande para ser una protección"

#: includes/checks/class-cascr-checks-files.php:428
msgid "it could not be read"
msgstr "no se ha podido leer"

#: includes/checks/class-cascr-checks-files.php:483
msgid "it runs a shell command"
msgstr "ejecuta un comando de shell"

#: includes/checks/class-cascr-checks-files.php:487
msgid "it builds a variable name at runtime"
msgstr "construye un nombre de variable en tiempo de ejecución"

#. translators: %s: a PHP keyword such as require or eval.
#: includes/checks/class-cascr-checks-files.php:496
#, php-format
msgid "it uses %s"
msgstr "usa %s"

#. translators: %s: name of a PHP superglobal, for example $_GET.
#: includes/checks/class-cascr-checks-files.php:505
#, php-format
msgid "it reads %s"
msgstr "lee %s"

#: includes/checks/class-cascr-checks-files.php:512
msgid "it calls a function held in a variable"
msgstr "llama a una función guardada en una variable"

#. translators: %s: name of a PHP function, for example base64_decode.
#: includes/checks/class-cascr-checks-files.php:518
#, php-format
msgid "it calls %s"
msgstr "llama a %s"

#: includes/checks/class-cascr-checks-files.php:524
msgid "it prints output of its own"
msgstr "genera salida propia"

#: includes/checks/class-cascr-checks-files.php:561
msgid "The filesystem could not be initialised for this check."
msgstr ""
"No se ha podido inicializar el sistema de archivos para esta comprobación."

#: includes/checks/class-cascr-checks-files.php:578
msgid "A test file could not be written to the uploads directory."
msgstr ""
"No se ha podido escribir un archivo de prueba en el directorio uploads."

#: includes/checks/class-cascr-checks-files.php:596
msgid "The test file could not be requested over HTTP."
msgstr "No se ha podido solicitar el archivo de prueba por HTTP."

#: includes/checks/class-cascr-checks-files.php:602
msgid "PHP files in the uploads directory are not served."
msgstr "Los archivos PHP del directorio uploads no se sirven."

#: includes/checks/class-cascr-checks-files.php:613
msgid ""
"The server runs PHP files from the uploads directory, which turns any file "
"upload flaw into code execution."
msgstr ""
"El servidor ejecuta archivos PHP del directorio uploads, lo que convierte "
"cualquier fallo en la subida de archivos en ejecución de código."

#: includes/checks/class-cascr-checks-files.php:616
msgid "Deny .php files in the uploads directory."
msgstr "Deniega los archivos .php en el directorio uploads."

#: includes/checks/class-cascr-checks-files.php:622
msgid ""
"The server does not run PHP files in the uploads directory but hands them "
"out as text, so anything uploaded there can be read back line by line."
msgstr ""
"El servidor no ejecuta archivos PHP en el directorio uploads, pero los "
"entrega como texto, así que cualquier cosa subida ahí se puede leer línea a "
"línea."

#: includes/checks/class-cascr-checks-files.php:625
msgid ""
"Deny access to .php files in the uploads directory instead of only switching"
" the interpreter off for them."
msgstr ""
"Deniega el acceso a los archivos .php en el directorio uploads en lugar de "
"solo desactivar el intérprete para ellos."

#: includes/checks/class-cascr-checks-files.php:629
msgid "PHP files in the uploads directory are not executed."
msgstr "Los archivos PHP del directorio uploads no se ejecutan."

#. translators: %d: number of publicly readable configuration files.
#: includes/checks/class-cascr-checks-files.php:669
#, php-format
msgid "%d configuration or backup file is readable from the web."
msgid_plural "%d configuration or backup files are readable from the web."
msgstr[0] ""
"%d archivo de configuración o de copia de seguridad se puede leer desde la "
"web."
msgstr[1] ""
"%d archivos de configuración o de copia de seguridad se pueden leer desde la"
" web."

#: includes/checks/class-cascr-checks-files.php:679
msgid ""
"Delete the files. Anything readable here can contain database credentials "
"and API keys."
msgstr ""
"Borra los archivos. Todo lo que se pueda leer aquí puede contener "
"credenciales de la base de datos y claves de API."

#. translators: %d: number of configuration files present but not served.
#: includes/checks/class-cascr-checks-files.php:687
#, php-format
msgid ""
"%d configuration or backup file sits in the web root but is not served."
msgid_plural ""
"%d configuration or backup files sit in the web root but are not served."
msgstr[0] ""
"Hay %d archivo de configuración o de copia de seguridad en la raíz web, "
"aunque no se sirve."
msgstr[1] ""
"Hay %d archivos de configuración o de copia de seguridad en la raíz web, "
"aunque no se sirven."

#: includes/checks/class-cascr-checks-files.php:697
msgid ""
"Move the files out of the web root. A server configuration change is all it "
"takes to expose them."
msgstr ""
"Saca los archivos de la raíz web. Basta un cambio en la configuración del "
"servidor para exponerlos."

#: includes/checks/class-cascr-checks-files.php:702
msgid "It could not be verified whether these files are publicly readable."
msgstr "No se ha podido verificar si estos archivos son de lectura pública."

#: includes/checks/class-cascr-checks-files.php:705
msgid "No configuration or backup files were found in the web root."
msgstr ""
"No se han encontrado archivos de configuración ni de copia de seguridad en "
"la raíz web."

#: includes/checks/class-cascr-checks-files.php:733
msgid ""
"A version control directory is readable from the web, which exposes the full"
" source history and often credentials along with it."
msgstr ""
"Un directorio de control de versiones se puede leer desde la web, lo que "
"expone todo el historial del código y a menudo también credenciales."

#: includes/checks/class-cascr-checks-files.php:736
msgid ""
"Block the directory at the server, or deploy without the repository "
"metadata."
msgstr ""
"Bloquea el directorio en el servidor o despliega sin los metadatos del "
"repositorio."

#: includes/checks/class-cascr-checks-files.php:741
msgid "The version control paths could not be checked."
msgstr "No se han podido comprobar las rutas de control de versiones."

#: includes/checks/class-cascr-checks-files.php:744
msgid "No version control directory is readable from the web."
msgstr "Ningún directorio de control de versiones se puede leer desde la web."

#: includes/checks/class-cascr-checks-files.php:773
msgid "No database dumps or archives were found in the web root."
msgstr ""
"No se han encontrado volcados de base de datos ni archivos comprimidos en la"
" raíz web."

#: includes/checks/class-cascr-checks-files.php:804
msgid "A database dump or archive can be downloaded from the site."
msgstr ""
"Se puede descargar un volcado de base de datos o un archivo comprimido desde"
" el sitio."

#: includes/checks/class-cascr-checks-files.php:807
msgid ""
"Delete the file immediately and assume its contents are known. Then rotate "
"the database password and the authentication keys."
msgstr ""
"Borra el archivo de inmediato y da por hecho que su contenido es conocido. "
"Después cambia la contraseña de la base de datos y las claves de "
"autenticación."

#. translators: %d: number of dumps or archives found.
#: includes/checks/class-cascr-checks-files.php:815
#, php-format
msgid "%d database dump or archive sits in the web root but is not served."
msgid_plural ""
"%d database dumps or archives sit in the web root but are not served."
msgstr[0] ""
"Hay %d volcado de base de datos o archivo comprimido en la raíz web, aunque "
"no se sirve."
msgstr[1] ""
"Hay %d volcados de base de datos o archivos comprimidos en la raíz web, "
"aunque no se sirven."

#: includes/checks/class-cascr-checks-files.php:825
msgid "Move the files somewhere outside the web root."
msgstr "Mueve los archivos a algún lugar fuera de la raíz web."

#: includes/checks/class-cascr-checks-files.php:830
msgid ""
"A database dump or archive lies in the web root, and whether the server "
"hands it out could not be verified."
msgstr ""
"Hay un volcado de base de datos o un archivo comprimido en la raíz web y no "
"se ha podido verificar si el servidor lo entrega."

#: includes/checks/class-cascr-checks-files.php:831
msgid ""
"Move the files somewhere outside the web root rather than waiting for the "
"answer."
msgstr ""
"Mueve los archivos fuera de la raíz web en lugar de esperar la respuesta."

#: includes/checks/class-cascr-checks-files.php:850
msgid "The web root holds no leftover files."
msgstr "La raíz web no contiene archivos sobrantes."

#. translators: %d: number of leftover files.
#: includes/checks/class-cascr-checks-files.php:856
#, php-format
msgid "%d leftover file sits in the web root."
msgid_plural "%d leftover files sit in the web root."
msgstr[0] "Hay %d archivo sobrante en la raíz web."
msgstr[1] "Hay %d archivos sobrantes en la raíz web."

#: includes/checks/class-cascr-checks-files.php:866
msgid "These files reveal version and tooling details. Deleting them is safe."
msgstr ""
"Estos archivos revelan detalles de versiones y herramientas. Se pueden "
"borrar sin problema."

#. translators: 1: path, 2: human readable age.
#: includes/checks/class-cascr-checks-files.php:900
#, php-format
msgid "%1$s, left behind %2$s ago"
msgstr "%1$s, abandonado hace %2$s"

#: includes/checks/class-cascr-checks-files.php:908
msgid "No leftovers from interrupted updates were found."
msgstr "No se han encontrado restos de actualizaciones interrumpidas."

#. translators: %d: number of leftover directories.
#: includes/checks/class-cascr-checks-files.php:914
#, php-format
msgid "%d leftover from an interrupted update is still on disk."
msgid_plural "%d leftovers from interrupted updates are still on disk."
msgstr[0] "Sigue en el disco %d resto de una actualización interrumpida."
msgstr[1] "Siguen en el disco %d restos de actualizaciones interrumpidas."

#: includes/checks/class-cascr-checks-files.php:924
msgid ""
"These folders can hold unpacked, outdated copies of plugins that are still "
"reachable. Delete them."
msgstr ""
"Estas carpetas pueden contener copias descomprimidas y desactualizadas de "
"plugins que siguen siendo accesibles. Bórralas."

#: includes/checks/class-cascr-checks-files.php:966
msgid ""
"The server lists directory contents, which hands attackers a map of the "
"installation."
msgstr ""
"El servidor muestra el contenido de los directorios, lo que da a los "
"atacantes un mapa de la instalación."

#: includes/checks/class-cascr-checks-files.php:974
msgid "Directory listing could not be checked."
msgstr "No se ha podido comprobar el listado de directorios."

#: includes/checks/class-cascr-checks-files.php:977
msgid "The server does not list directory contents."
msgstr "El servidor no muestra el contenido de los directorios."

#: includes/checks/class-cascr-checks-files.php:994
msgid ""
"This server does not use .htaccess. Its rules live in the server "
"configuration and cannot be inspected from here."
msgstr ""
"Este servidor no usa .htaccess. Sus reglas están en la configuración del "
"servidor y no se pueden revisar desde aquí."

#: includes/checks/class-cascr-checks-files.php:999
msgid "An .htaccess file is present."
msgstr "Hay un archivo .htaccess."

#: includes/checks/class-cascr-checks-files.php:1003
msgid ""
"No .htaccess file was found, so none of the usual hardening rules are in "
"place."
msgstr ""
"No se ha encontrado ningún archivo .htaccess, así que no se aplica ninguna "
"de las reglas de protección habituales."

#: includes/checks/class-cascr-checks-files.php:1006
msgid ""
"Save the permalink settings once. WordPress writes a basic .htaccess by "
"itself."
msgstr ""
"Guarda una vez los ajustes de enlaces permanentes. WordPress escribe un "
".htaccess básico por sí solo."

#: includes/checks/class-cascr-checks-files.php:1020
msgid ""
"On Apache and LiteSpeed an .htaccess in that directory does it, as long as "
"AllowOverride allows the rule; on nginx and Caddy it belongs in the server "
"configuration."
msgstr ""
"En Apache y LiteSpeed basta con un .htaccess en ese directorio, siempre que "
"AllowOverride permita la regla; en nginx y Caddy va en la configuración del "
"servidor."

#. translators: %s: comma separated file names, for example ".user.ini,
#. .htpasswd".
#: includes/checks/class-cascr-checks-files.php:1038
#, php-format
msgid ""
"Keep %s: those are running configuration, not leftovers. Deny access to them"
" at the server instead of deleting them."
msgstr ""
"Conserva %s: forman parte de la configuración en uso, no son restos. Deniega"
" el acceso a ellos en el servidor en lugar de borrarlos."

#: includes/checks/class-cascr-checks-network.php:52
msgid ""
"The site address still uses http, so every login and every form submission "
"travels in the clear."
msgstr ""
"La dirección del sitio todavía usa http, así que cada acceso y cada envío de"
" formulario viaja sin cifrar."

#: includes/checks/class-cascr-checks-network.php:55
msgid ""
"Get a certificate, switch the site and home addresses to https and redirect "
"http to https."
msgstr ""
"Consigue un certificado, cambia las direcciones del sitio y de WordPress a "
"https y redirige http a https."

#: includes/checks/class-cascr-checks-network.php:62
msgid "FORCE_SSL_ADMIN is not set"
msgstr "FORCE_SSL_ADMIN no está definida"

#: includes/checks/class-cascr-checks-network.php:63
msgid ""
"The site is served over HTTPS, but the dashboard can still be reached over "
"http: FORCE_SSL_ADMIN is not set."
msgstr ""
"El sitio se sirve por HTTPS, pero el escritorio sigue siendo accesible por "
"http: FORCE_SSL_ADMIN no está definida."

#: includes/checks/class-cascr-checks-network.php:74
msgid "the http address does not redirect permanently to https"
msgstr "la dirección http no redirige de forma permanente a https"

#: includes/checks/class-cascr-checks-network.php:75
msgid ""
"The http address does not redirect permanently to https, so a visitor who "
"types the bare domain can still be served over http."
msgstr ""
"La dirección http no redirige de forma permanente a https, así que a un "
"visitante que escribe solo el dominio se le puede seguir sirviendo por http."

#: includes/checks/class-cascr-checks-network.php:80
msgid "The site is served over HTTPS and http is redirected."
msgstr "El sitio se sirve por HTTPS y http se redirige."

#: includes/checks/class-cascr-checks-network.php:90
msgid ""
"Add define( 'FORCE_SSL_ADMIN', true ); to wp-config.php and redirect http to"
" https with a 301."
msgstr ""
"Añade define( 'FORCE_SSL_ADMIN', true ); a wp-config.php y redirige http a "
"https con un 301."

#: includes/checks/class-cascr-checks-network.php:108
msgid "The site does not use HTTPS, so there is no certificate to inspect."
msgstr "El sitio no usa HTTPS, así que no hay ningún certificado que revisar."

#: includes/checks/class-cascr-checks-network.php:112
msgid "This server cannot inspect TLS certificates."
msgstr "Este servidor no puede revisar certificados TLS."

#: includes/checks/class-cascr-checks-network.php:140
msgid "No TLS connection to the site could be opened from the server itself."
msgstr ""
"No se ha podido abrir ninguna conexión TLS con el sitio desde el propio "
"servidor."

#: includes/checks/class-cascr-checks-network.php:152
msgid "The certificate could not be read."
msgstr "No se ha podido leer el certificado."

#: includes/checks/class-cascr-checks-network.php:158
msgid "The certificate could not be parsed."
msgstr "No se ha podido analizar el certificado."

#. translators: %s: certificate expiry date.
#: includes/checks/class-cascr-checks-network.php:180
#, php-format
msgid "valid until %s"
msgstr "válido hasta el %s"

#: includes/checks/class-cascr-checks-network.php:183
msgid "the trust chain and the host name are not checked here"
msgstr "aquí no se comprueban la cadena de confianza ni el nombre de host"

#: includes/checks/class-cascr-checks-network.php:192
msgid ""
"The TLS certificate has expired. Visitors get a browser warning instead of "
"the site."
msgstr ""
"El certificado TLS ha caducado. Los visitantes ven un aviso del navegador en"
" lugar del sitio."

#: includes/checks/class-cascr-checks-network.php:195
msgid ""
"Renew the certificate now and check that automatic renewal actually runs."
msgstr ""
"Renueva el certificado ahora y comprueba que la renovación automática "
"funciona de verdad."

#. translators: %s: human readable time until expiry.
#: includes/checks/class-cascr-checks-network.php:203
#, php-format
msgid "The TLS certificate expires in %s."
msgstr "El certificado TLS caduca en %s."

#: includes/checks/class-cascr-checks-network.php:208
msgid "Renew it and check that automatic renewal runs."
msgstr "Renuévalo y comprueba que la renovación automática funciona."

#. translators: %s: human readable time until expiry.
#: includes/checks/class-cascr-checks-network.php:216
#, php-format
msgid ""
"The TLS certificate expires in %s, which leaves little room if a renewal "
"fails."
msgstr ""
"El certificado TLS caduca en %s, lo que deja poco margen si falla una "
"renovación."

#: includes/checks/class-cascr-checks-network.php:221
msgid ""
"Renew it and let the renewal run automatically. Certificate lifetimes drop "
"to 100 days in March 2027 and to 47 days in 2029, so a manual renewal will "
"get tight."
msgstr ""
"Renuévalo y deja que la renovación se haga de forma automática. La validez "
"de los certificados baja a 100 días en marzo de 2027 y a 47 días en 2029, "
"así que renovar a mano se va a quedar corto."

#. translators: %s: negotiated TLS protocol version.
#: includes/checks/class-cascr-checks-network.php:229
#, php-format
msgid "The connection was negotiated over %s, which browsers have retired."
msgstr "La conexión se negoció con %s, que los navegadores ya han retirado."

#: includes/checks/class-cascr-checks-network.php:234
msgid "Ask the host to allow TLS 1.2 and 1.3 only."
msgstr "Pide a tu proveedor de alojamiento que permita solo TLS 1.2 y 1.3."

#: includes/checks/class-cascr-checks-network.php:239
msgid ""
"The TLS certificate is within its validity period and not about to expire."
msgstr ""
"El certificado TLS está dentro de su periodo de validez y no va a caducar "
"pronto."

#: includes/checks/class-cascr-checks-network.php:257
#: includes/checks/class-cascr-checks-network.php:341
#: includes/checks/class-cascr-checks-network.php:420
#: includes/checks/class-cascr-checks-network.php:610
#: includes/checks/class-cascr-checks-network.php:653
msgid "The response headers could not be retrieved."
msgstr "No se han podido obtener las cabeceras de respuesta."

#: includes/checks/class-cascr-checks-network.php:297
msgid "All recommended security headers are present."
msgstr "Están todas las cabeceras de seguridad recomendadas."

#. translators: %s: comma separated list of optional headers.
#: includes/checks/class-cascr-checks-network.php:303
#, php-format
msgid "optional and not set: %s"
msgstr "opcionales y sin definir: %s"

#. translators: %d: number of missing security headers.
#: includes/checks/class-cascr-checks-network.php:314
#, php-format
msgid "%d recommended security header is missing."
msgid_plural "%d recommended security headers are missing."
msgstr[0] "Falta %d cabecera de seguridad recomendada."
msgstr[1] "Faltan %d cabeceras de seguridad recomendadas."

#: includes/checks/class-cascr-checks-network.php:335
msgid "HSTS only applies to sites served over HTTPS."
msgstr "HSTS solo se aplica a sitios servidos por HTTPS."

#: includes/checks/class-cascr-checks-network.php:348
msgid ""
"No HSTS header is sent, so the first request of a visit can still be "
"downgraded to http."
msgstr ""
"No se envía ninguna cabecera HSTS, así que la primera petición de una visita"
" todavía se puede degradar a http."

#: includes/checks/class-cascr-checks-network.php:351
msgid ""
"Send Strict-Transport-Security: max-age=31536000; includeSubDomains once the"
" whole site is reliably on HTTPS."
msgstr ""
"Envía Strict-Transport-Security: max-age=31536000; includeSubDomains cuando "
"todo el sitio funcione de forma fiable con HTTPS."

#. translators: %s: recommended minimum lifetime, already formatted.
#: includes/checks/class-cascr-checks-network.php:368
#, php-format
msgid ""
"the header carries no usable max-age, so it expires immediately instead of "
"lasting at least %s"
msgstr ""
"la cabecera no lleva un max-age utilizable, así que caduca de inmediato en "
"lugar de durar al menos %s"

#: includes/checks/class-cascr-checks-network.php:372
msgid "no usable max-age"
msgstr "sin max-age utilizable"

#. translators: 1: current max-age as a duration, 2: recommended minimum as a
#. duration.
#: includes/checks/class-cascr-checks-network.php:376
#, php-format
msgid "max-age lasts %1$s, the recommendation is at least %2$s"
msgstr "max-age dura %1$s, lo recomendado es al menos %2$s"

#. translators: %s: current max-age as a duration.
#: includes/checks/class-cascr-checks-network.php:383
#, php-format
msgid "a max-age of only %s"
msgstr "un max-age de solo %s"

#: includes/checks/class-cascr-checks-network.php:389
msgid "includeSubDomains is not set"
msgstr "includeSubDomains no está establecido"

#: includes/checks/class-cascr-checks-network.php:390
msgid "no includeSubDomains"
msgstr "sin includeSubDomains"

#: includes/checks/class-cascr-checks-network.php:394
msgid "The HSTS header is set up properly."
msgstr "La cabecera HSTS está bien configurada."

#. translators: %s: comma separated list of what the header is missing.
#: includes/checks/class-cascr-checks-network.php:402
#, php-format
msgid "The HSTS header is present but weak: %s."
msgstr "La cabecera HSTS está presente, pero es débil: %s."

#: includes/checks/class-cascr-checks-network.php:407
msgid ""
"Use max-age=31536000; includeSubDomains, which is one year. Anything shorter"
" than six months counts as weak here. Add preload only when every subdomain "
"is on HTTPS for good."
msgstr ""
"Usa max-age=31536000; includeSubDomains, es decir, un año. Aquí, cualquier "
"valor inferior a seis meses se considera débil. Añade preload solo cuando "
"todos los subdominios estén en HTTPS de forma definitiva."

#: includes/checks/class-cascr-checks-network.php:428
msgid ""
"No Content Security Policy is sent, so an injected script runs with no "
"restriction."
msgstr ""
"No se envía ninguna Content Security Policy, así que un script inyectado se "
"ejecuta sin ninguna restricción."

#: includes/checks/class-cascr-checks-network.php:431
msgid ""
"Start with Content-Security-Policy-Report-Only, watch the reports for a "
"while, then switch it to the enforcing header."
msgstr ""
"Empieza con Content-Security-Policy-Report-Only, observa los informes "
"durante un tiempo y después cambia a la cabecera que la aplica."

#: includes/checks/class-cascr-checks-network.php:437
msgid ""
"The Content Security Policy is only sent in report-only mode, so nothing is "
"actually blocked."
msgstr ""
"La Content Security Policy solo se envía en modo report-only, así que en "
"realidad no se bloquea nada."

#: includes/checks/class-cascr-checks-network.php:440
msgid ""
"Once the reports are quiet, send the same policy as Content-Security-Policy."
msgstr ""
"Cuando los informes dejen de mostrar avisos, envía la misma política como "
"Content-Security-Policy."

#: includes/checks/class-cascr-checks-network.php:481
msgid "'unsafe-inline' allows injected inline scripts to run"
msgstr "'unsafe-inline' permite que se ejecuten scripts inline inyectados"

#: includes/checks/class-cascr-checks-network.php:482
msgid "inline scripts ('unsafe-inline')"
msgstr "scripts inline ('unsafe-inline')"

#: includes/checks/class-cascr-checks-network.php:486
msgid "'unsafe-eval' allows strings to be executed as code"
msgstr "'unsafe-eval' permite ejecutar cadenas como código"

#: includes/checks/class-cascr-checks-network.php:487
msgid "eval ('unsafe-eval')"
msgstr "eval ('unsafe-eval')"

#: includes/checks/class-cascr-checks-network.php:491
msgid "a wildcard source allows scripts from anywhere"
msgstr "una fuente comodín permite scripts desde cualquier lugar"

#: includes/checks/class-cascr-checks-network.php:492
msgid "a wildcard script source"
msgstr "una fuente de scripts comodín"

#: includes/checks/class-cascr-checks-network.php:496
msgid "neither default-src nor object-src is set"
msgstr "no se ha establecido ni default-src ni object-src"

#: includes/checks/class-cascr-checks-network.php:497
msgid "no fallback directive"
msgstr "sin directiva de respaldo"

#: includes/checks/class-cascr-checks-network.php:501
msgid ""
"A Content Security Policy is enforced and contains no obvious escape hatch."
msgstr ""
"Se aplica una Content Security Policy y no contiene ninguna vía de escape "
"evidente."

#. translators: %s: comma separated list of the weak parts of the policy.
#: includes/checks/class-cascr-checks-network.php:509
#, php-format
msgid "A Content Security Policy is enforced but leaves openings: %s."
msgstr "Se aplica una Content Security Policy, pero deja huecos: %s."

#: includes/checks/class-cascr-checks-network.php:514
msgid ""
"Replace unsafe-inline with a nonce or a hash for the scripts the site really"
" needs."
msgstr ""
"Sustituye unsafe-inline por un nonce o un hash para los scripts que el sitio"
" realmente necesita."

#: includes/checks/class-cascr-checks-network.php:533
msgid "The login page could not be requested."
msgstr "No se ha podido solicitar la página de acceso."

#: includes/checks/class-cascr-checks-network.php:540
msgid "The login page set no cookies that could be inspected."
msgstr ""
"La página de acceso no estableció ninguna cookie que se pudiera "
"inspeccionar."

#. translators: %s: cookie name.
#: includes/checks/class-cascr-checks-network.php:564
#, php-format
msgid "%s is not marked Secure"
msgstr "%s no está marcada como Secure"

#. translators: %s: cookie name.
#: includes/checks/class-cascr-checks-network.php:575
#, php-format
msgid "%s is readable from JavaScript, it has no HttpOnly attribute"
msgstr "%s se puede leer desde JavaScript, no tiene el atributo HttpOnly"

#. translators: %s: cookie name.
#: includes/checks/class-cascr-checks-network.php:583
#, php-format
msgid "%s has no SameSite attribute"
msgstr "%s no tiene atributo SameSite"

#: includes/checks/class-cascr-checks-network.php:590
msgid ""
"The cookies the login page hands out before sign-in carry the right "
"attributes."
msgstr ""
"Las cookies que entrega la página de acceso antes de iniciar sesión llevan "
"los atributos correctos."

#: includes/checks/class-cascr-checks-network.php:594
msgid ""
"The login page hands out cookies without the attributes that limit where a "
"browser will send them back."
msgstr ""
"La página de acceso entrega cookies sin los atributos que limitan adónde las"
" devuelve el navegador."

#: includes/checks/class-cascr-checks-network.php:597
msgid ""
"Set HttpOnly, SameSite=Lax and, on an HTTPS site, Secure at the server. The "
"session cookies appear only after a successful sign-in and are not part of "
"this measurement."
msgstr ""
"Establece HttpOnly, SameSite=Lax y, en un sitio HTTPS, Secure en el "
"servidor. Las cookies de sesión solo aparecen tras un inicio de sesión "
"correcto y no forman parte de esta medición."

#: includes/checks/class-cascr-checks-network.php:617
msgid "No cross-origin headers are sent, which is the right default."
msgstr ""
"No se envía ninguna cabecera de origen cruzado, que es lo correcto por "
"defecto."

#: includes/checks/class-cascr-checks-network.php:622
msgid ""
"Every origin is allowed to read responses and to send credentials along."
msgstr "Cualquier origen puede leer las respuestas y enviar credenciales."

#: includes/checks/class-cascr-checks-network.php:625
msgid "Never combine the two. Name the origins that are actually allowed."
msgstr ""
"Nunca combines ambas cosas. Indica los orígenes que realmente están "
"permitidos."

#: includes/checks/class-cascr-checks-network.php:631
msgid "Every origin is allowed to read responses from this site."
msgstr "Cualquier origen puede leer las respuestas de este sitio."

#: includes/checks/class-cascr-checks-network.php:634
msgid ""
"Name the origins that are actually allowed instead of using the wildcard."
msgstr ""
"Indica los orígenes que realmente están permitidos en lugar de usar el "
"comodín."

#: includes/checks/class-cascr-checks-network.php:639
msgid "Cross-origin access is limited to a named origin."
msgstr "El acceso de origen cruzado está limitado a un origen concreto."

#: includes/checks/class-cascr-checks-network.php:667
msgid "The response headers do not name software versions."
msgstr "Las cabeceras de respuesta no indican versiones de software."

#: includes/checks/class-cascr-checks-network.php:671
msgid ""
"The response headers name the exact software versions in use, which saves an"
" attacker the work of finding out."
msgstr ""
"Las cabeceras de respuesta indican las versiones exactas del software en "
"uso, lo que ahorra a un atacante el trabajo de averiguarlas."

#: includes/checks/class-cascr-checks-network.php:687
msgid "The front page could not be retrieved."
msgstr "No se ha podido obtener la página de inicio."

#. translators: %s: WordPress version number.
#: includes/checks/class-cascr-checks-network.php:697
#, php-format
msgid "generator tag naming WordPress %s"
msgstr "etiqueta generator que indica WordPress %s"

#: includes/checks/class-cascr-checks-network.php:700
msgid "generator tag naming WordPress"
msgstr "etiqueta generator que indica WordPress"

#: includes/checks/class-cascr-checks-network.php:704
msgid "Windows Live Writer manifest link"
msgstr "enlace al manifiesto de Windows Live Writer"

#: includes/checks/class-cascr-checks-network.php:708
msgid "Really Simple Discovery link"
msgstr "enlace Really Simple Discovery"

#: includes/checks/class-cascr-checks-network.php:712
msgid "The front page emits no legacy discovery tags."
msgstr "La página de inicio no emite etiquetas de descubrimiento heredadas."

#: includes/checks/class-cascr-checks-network.php:716
msgid ""
"The front page emits discovery tags that give away details about the "
"installation."
msgstr ""
"La página de inicio emite etiquetas de descubrimiento que revelan detalles "
"de la instalación."

#: includes/checks/class-cascr-checks-network.php:719
msgid ""
"Remove the generator, wlwmanifest and RSD hooks from wp_head. This is "
"fingerprinting, not a hole in itself."
msgstr ""
"Elimina los hooks de generator, wlwmanifest y RSD de wp_head. Sirve para "
"identificar la instalación (fingerprinting), no es un agujero en sí mismo."

#: includes/checks/class-cascr-checks-network.php:740
msgid "The XML-RPC endpoint could not be reached."
msgstr "No se ha podido acceder al endpoint de XML-RPC."

#: includes/checks/class-cascr-checks-network.php:747
msgid "The XML-RPC endpoint is blocked."
msgstr "El endpoint de XML-RPC está bloqueado."

#: includes/checks/class-cascr-checks-network.php:751
msgid "The XML-RPC endpoint does not answer method calls."
msgstr "El endpoint de XML-RPC no responde a llamadas de métodos."

#: includes/checks/class-cascr-checks-network.php:764
msgid ""
"the xmlrpc_enabled filter refuses every method that needs a login, but the "
"endpoint keeps answering"
msgstr ""
"el filtro xmlrpc_enabled rechaza todos los métodos que requieren iniciar "
"sesión, pero el endpoint sigue respondiendo"

#: includes/checks/class-cascr-checks-network.php:768
msgid ""
"system.multicall bundles many calls into one request. Since WordPress 4.4 "
"the first failed login ends the rest, so it no longer multiplies password "
"guesses, but one request still does the work of many"
msgstr ""
"system.multicall agrupa muchas llamadas en una sola petición. Desde "
"WordPress 4.4, el primer inicio de sesión fallido detiene el resto, así que "
"ya no multiplica los intentos de contraseña, pero una sola petición sigue "
"haciendo el trabajo de muchas"

#: includes/checks/class-cascr-checks-network.php:772
msgid ""
"pingback.ping is available, which lets the site be used to probe other hosts"
msgstr ""
"pingback.ping está disponible, lo que permite usar el sitio para sondear "
"otros servidores"

#: includes/checks/class-cascr-checks-network.php:777
msgid "The XML-RPC endpoint answers method calls."
msgstr "El endpoint de XML-RPC responde a llamadas de métodos."

#: includes/checks/class-cascr-checks-network.php:780
msgid ""
"If nothing uses XML-RPC, block xmlrpc.php in the web server, which is the "
"only place that stops the requests before WordPress handles them. The "
"xmlrpc_enabled filter only turns away the methods that need a login. Jetpack"
" and the mobile apps are the usual reasons to leave it open."
msgstr ""
"Si nada usa XML-RPC, bloquea xmlrpc.php en el servidor web, que es el único "
"sitio donde se detienen las peticiones antes de que WordPress las procese. "
"El filtro xmlrpc_enabled solo rechaza los métodos que requieren iniciar "
"sesión. Jetpack y las aplicaciones móviles son los motivos habituales para "
"dejarlo abierto."

#: includes/checks/class-cascr-checks-network.php:832
msgid ""
"the ?author=N parameter redirects to the author archive and gives the login "
"name away"
msgstr ""
"el parámetro ?author=N redirige al archivo del autor y revela el nombre de "
"acceso"

#: includes/checks/class-cascr-checks-network.php:834
msgid ""
"the ?author=N parameter answers with an author archive, which confirms which"
" account IDs exist"
msgstr ""
"el parámetro ?author=N responde con un archivo de autor, lo que confirma qué"
" ID de cuenta existen"

#. translators: %d: number of user records returned by the REST API.
#: includes/checks/class-cascr-checks-network.php:847
#, php-format
msgid "the REST endpoint /wp/v2/users lists %d account"
msgid_plural "the REST endpoint /wp/v2/users lists %d accounts"
msgstr[0] "el endpoint REST /wp/v2/users lista %d cuenta"
msgstr[1] "el endpoint REST /wp/v2/users lista %d cuentas"

#: includes/checks/class-cascr-checks-network.php:864
msgid "the oEmbed endpoint reveals the author"
msgstr "el endpoint oEmbed revela el autor"

#: includes/checks/class-cascr-checks-network.php:870
msgid "User enumeration could not be checked."
msgstr "No se ha podido comprobar la enumeración de usuarios."

#: includes/checks/class-cascr-checks-network.php:871
msgid "The usual ways of reading out user names are closed."
msgstr ""
"Las vías habituales para obtener los nombres de usuario están cerradas."

#: includes/checks/class-cascr-checks-network.php:875
msgid ""
"User names can be read without logging in, which turns password guessing "
"from two unknowns into one."
msgstr ""
"Los nombres de usuario se pueden leer sin iniciar sesión, así que para "
"adivinar una contraseña ya solo queda una incógnita en lugar de dos."

#: includes/checks/class-cascr-checks-network.php:878
msgid ""
"Require authentication on the users endpoint and stop the ?author redirect. "
"A different display name changes nothing here: the author slug keeps the "
"login name it was generated from, and that is what the redirect and the REST"
" answer carry."
msgstr ""
"Exige autenticación en el endpoint de usuarios y detén la redirección de "
"?author. Cambiar el nombre visible no sirve de nada aquí: el slug del autor "
"conserva el nombre de acceso a partir del cual se generó, y eso es lo que "
"devuelven la redirección y la respuesta REST."

#: includes/checks/class-cascr-checks-network.php:889
msgid "The REST API is not available."
msgstr "La API REST no está disponible."

#. translators: 1: REST route, 2: comma separated HTTP methods.
#: includes/checks/class-cascr-checks-network.php:914
#, php-format
msgid "%1$s accepts %2$s and names no permission callback at all"
msgstr "%1$s acepta %2$s y no indica ningún callback de permisos"

#. translators: 1: REST route, 2: comma separated HTTP methods.
#: includes/checks/class-cascr-checks-network.php:921
#, php-format
msgid "%1$s is registered as open to anyone for %2$s"
msgstr "%1$s está registrada como abierta a cualquiera para %2$s"

#: includes/checks/class-cascr-checks-network.php:933
msgid "Every REST route that changes data decides who may call it."
msgstr "Cada ruta REST que modifica datos decide quién puede llamarla."

#. translators: %d: number of write routes without a permission callback.
#: includes/checks/class-cascr-checks-network.php:943
#, php-format
msgid "%d REST route accepts changes without naming a permission callback."
msgid_plural ""
"%d REST routes accept changes without naming a permission callback."
msgstr[0] "%d ruta REST acepta cambios sin indicar un callback de permisos."
msgstr[1] "%d rutas REST aceptan cambios sin indicar un callback de permisos."

#: includes/checks/class-cascr-checks-network.php:953
msgid ""
"Since WordPress 5.5 every route has to name one. The route belongs to "
"whichever plugin registered it, so report it to the author and remove the "
"plugin until it is fixed."
msgstr ""
"Desde WordPress 5.5, cada ruta tiene que indicar uno. La ruta pertenece al "
"plugin que la registró, así que comunícaselo a su autor y elimina el plugin "
"hasta que se corrija."

#. translators: %d: number of write routes that are open on purpose.
#: includes/checks/class-cascr-checks-network.php:960
#, php-format
msgid "%d REST route accepts changes from anyone who asks."
msgid_plural "%d REST routes accept changes from anyone who asks."
msgstr[0] "%d ruta REST acepta cambios de cualquiera que los envíe."
msgstr[1] "%d rutas REST aceptan cambios de cualquiera que los envíe."

#: includes/checks/class-cascr-checks-network.php:970
msgid ""
"Some routes are open on purpose and check the request inside the callback, a"
" contact form or a shop cart for instance. Ask the plugin that registered "
"the route whether this one is meant to be open, and remove the plugin until "
"it is fixed if it is not."
msgstr ""
"Algunas rutas están abiertas a propósito y comprueban la petición dentro del"
" callback, por ejemplo un formulario de contacto o el carrito de una tienda."
" Pregunta al autor del plugin que registró la ruta si debe estar abierta y, "
"si no es así, elimina el plugin hasta que se corrija."

#: includes/checks/class-cascr-checks-network.php:1013
msgid ""
"This check reads the headers of the current request, and this run has none."
msgstr ""
"Esta comprobación lee las cabeceras de la petición actual, y este análisis "
"no tiene ninguna."

#: includes/checks/class-cascr-checks-network.php:1014
msgid "Open the report in the browser to have it checked."
msgstr "Abre el informe en el navegador para que se compruebe."

#: includes/checks/class-cascr-checks-network.php:1028
msgid ""
"No forwarded address headers arrive, so the client address cannot be faked "
"through them."
msgstr ""
"No llega ninguna cabecera de dirección reenviada, así que la dirección del "
"cliente no se puede falsificar a través de ellas."

#: includes/checks/class-cascr-checks-network.php:1045
msgid ""
"Forwarded address headers arrive from a proxy in front of the site, which is"
" the expected setup."
msgstr ""
"Llegan cabeceras de dirección reenviada desde un proxy situado delante del "
"sitio, que es la configuración esperada."

#. translators: 1: comma separated list of forwarded address headers, 2:
#. remote IP address of the current request.
#: includes/checks/class-cascr-checks-network.php:1053
#, php-format
msgid ""
"Forwarded address headers arrive (%1$s) from %2$s, and a header written by a"
" proxy looks the same from here as one a visitor sent along."
msgstr ""
"Llegan cabeceras de dirección reenviada (%1$s) desde %2$s, y desde aquí una "
"cabecera escrita por un proxy tiene el mismo aspecto que una enviada por un "
"visitante."

#: includes/checks/class-cascr-checks-network.php:1057
msgid ""
"If nothing sits in front of the site, have the security plugins read "
"REMOTE_ADDR. If a proxy does, make sure it overwrites these headers rather "
"than passing on whatever arrived."
msgstr ""
"Si no hay nada delante del sitio, haz que los plugins de seguridad lean "
"REMOTE_ADDR. Si hay un proxy, asegúrate de que sobrescribe estas cabeceras "
"en lugar de reenviar lo que le llegue."

#: includes/checks/class-cascr-checks-network.php:1095
msgid ""
"Send the headers from the web server so they cover static files too. Start "
"with X-Content-Type-Options and Referrer-Policy, they never break anything."
msgstr ""
"Envía las cabeceras desde el servidor web para que también cubran los "
"archivos estáticos. Empieza por X-Content-Type-Options y Referrer-Policy, "
"nunca rompen nada."

#: includes/checks/class-cascr-checks-transparency.php:49
msgid ""
"AI-generated content is labelled and visitors are told when they reach an AI"
" system."
msgstr ""
"El contenido generado por IA está etiquetado y se avisa a los visitantes "
"cuando interactúan con un sistema de IA."

#: includes/checks/class-cascr-checks-transparency.php:56
msgid ""
"A disclosure plugin is active but was never set up, so nothing is labelled "
"yet."
msgstr ""
"Hay un plugin de transparencia activo, pero nunca se configuró, así que "
"todavía no se etiqueta nada."

#: includes/checks/class-cascr-checks-transparency.php:59
msgid ""
"Open the plugin settings and switch the labelling on. Until that is saved "
"the plugin changes nothing a visitor can see."
msgstr ""
"Abre los ajustes del plugin y activa el etiquetado. Hasta que lo guardes, el"
" plugin no cambia nada que un visitante pueda ver."

#: includes/checks/class-cascr-checks-transparency.php:65
msgid ""
"Since 2 August 2026, Article 50 of the EU AI Act asks for a machine-readable"
" label on AI-generated content and for a notice when visitors are talking to"
" an AI system. No solution for that is active on this installation."
msgstr ""
"Desde el 2 de agosto de 2026, el artículo 50 de la Ley de IA de la UE exige "
"una etiqueta legible por máquina en el contenido generado por IA y un aviso "
"cuando los visitantes hablan con un sistema de IA. En esta instalación no "
"hay ninguna solución activa para ello."

#: includes/checks/class-cascr-checks-transparency.php:68
msgid ""
"If the site publishes AI-generated text, images or video, or runs a chatbot,"
" install one of the disclosure plugins from the directory and switch the "
"labelling on. EU AI Label and EU AI Act Ready are free and cover media "
"labels and a visitor notice. TransparAI, which we build ourselves, puts "
"media labels, text marking and chatbot disclosure in one place; it is named "
"here because it fits, not because you need it."
msgstr ""
"Si el sitio publica textos, imágenes o vídeos generados por IA, o tiene un "
"chatbot, instala uno de los plugins de transparencia del directorio y activa"
" el etiquetado. EU AI Label y EU AI Act Ready son gratuitos y cubren "
"etiquetas para medios y un aviso para visitantes. TransparAI, que "
"desarrollamos nosotros, reúne etiquetas para medios, marcado de texto y "
"aviso de chatbot en un solo lugar; lo mencionamos porque encaja, no porque "
"lo necesites."

#: includes/checks/class-cascr-checks-transparency.php:84
msgid "TransparAI, our own plugin for AI content disclosure"
msgstr ""
"TransparAI, nuestro propio plugin para la transparencia del contenido de IA"

#: includes/class-cascr-admin-dashboard.php:91
#: includes/class-cascr-admin.php:113
msgid "Risk score"
msgstr "Puntuación de riesgo"

#: includes/class-cascr-admin-dashboard.php:100
msgid "Re-check everything"
msgstr "Volver a comprobar todo"

#. translators: 1: date of the first recorded run, 2: grade letter, 3: number
#. of findings.
#: includes/class-cascr-admin-dashboard.php:133
#, php-format
msgid "Started on %1$s: grade %2$s with %3$d finding."
msgid_plural "Started on %1$s: grade %2$s with %3$d findings."
msgstr[0] "Iniciado el %1$s: nota %2$s con %3$d hallazgo."
msgstr[1] "Iniciado el %1$s: nota %2$s con %3$d hallazgos."

#. translators: 1: number of checks re-checked on their own, 2: date of the
#. last full pass.
#: includes/class-cascr-admin-dashboard.php:200
#, php-format
msgid "%1$d check has been re-checked on its own since the full pass on %2$s."
msgid_plural ""
"%1$d checks have been re-checked on their own since the full pass on %2$s."
msgstr[0] ""
"%1$d comprobación se ha vuelto a ejecutar por separado desde el análisis "
"completo del %2$s."
msgstr[1] ""
"%1$d comprobaciones se han vuelto a ejecutar por separado desde el análisis "
"completo del %2$s."

#. translators: %s: name of the check.
#: includes/class-cascr-admin-dashboard.php:272
#, php-format
msgid "%s passed the re-check."
msgstr "%s ha superado la nueva comprobación."

