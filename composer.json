{
	"name": "cms-admins/security-check-report",
	"description": "Performs a comprehensive series of security tests on your WordPress installation and provides an overall risk evaluation.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Patrick Schlesinger",
			"email": "ps@cms-admins.de"
		}
	],
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.10",
		"squizlabs/php_codesniffer": "^3.9",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse",
		"check-all": [
			"@lint",
			"@analyse"
		],
		"phplint": "parallel-lint --exclude vendor --exclude node_modules ."
	}
}
